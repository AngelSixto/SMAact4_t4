# Copia este archivo como db.properties (en la carpeta desde donde ejecutas la app)
# y pon tus datos reales. db.properties esta en .gitignore: NO se sube a GitHub.
spring.datasource.username=TU_USUARIO
spring.datasource.password=TU_PASSWORD
# Clave secreta para firmar los JWT, minimo 32 caracteres.
# En Linux puedes generar una con: openssl rand -base64 48
jwt.secret=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA_DE_MAS_DE_32_CARACTERES
# Opcional, si la base no es localhost:3306/smaact4_db
# spring.datasource.url=jdbc:mysql://localhost:3306/smaact4_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
