meta {
  name: 1. Registro
  type: http
  seq: 1
}

post {
  url: http://157.180.30.55:8088/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Angel Sixto",
    "email": "sixtoA@tecnmoaxaca.com",
    "password": "coliBri47$"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("token", res.getBody().token);
  }
}

tests {
  test("Responde 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Regresa un token JWT", function () {
    expect(res.getBody().token).to.be.a("string");
  });
  test("No expone el password", function () {
    expect(res.getBody().usuario).to.not.have.property("password");
  });
}

docs {
  Registra un usuario nuevo. Responde 201 con un token JWT.
  Si el email ya existe responde 409 Conflict.
}
