meta {
  name: 2. Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("token", res.getBody().token);
  }
}

tests {
  test("Responde 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Regresa un token Bearer", function () {
    expect(res.getBody().tipo).to.equal("Bearer");
    expect(res.getBody().token).to.be.a("string");
  });
}

docs {
  Inicia sesion. Guarda el token en la variable {{token}} para usarlo en las demas peticiones.
}
