meta {
  name: 4. Actualizar alumno (PUT)
  type: http
  seq: 4
}

put {
  url: http://157.180.30.55:8088/api/alumnos/4
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "numeroControl": "21160104",
    "nombre": "Adrea",
    "apellidos": "Vasquez Cruz",
    "email": "andyCruz@tecnm.com",
    "semestre": 8,
    "carreraId": 2
  }
}

tests {
  test("Responde 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("El semestre se actualizo a 8", function () {
    expect(res.getBody().semestre).to.equal(8);
  });
}
