meta {
  name: 1. Crear alumno (POST)
  type: http
  seq: 1
}

post {
  url: http://157.180.30.55:8088/api/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "numeroControl": "21160106",
    "nombre": "Neri",
    "apellidos": "Sixto Cruz",
    "email": "neri@itoaxaca.edu.com",
    "semestre": 4,
    "carreraId": 2
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("alumnoId", res.getBody().id);
  }
}

tests {
  test("Responde 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Incluye el header Location", function () {
    expect(res.getHeader("location")).to.be.a("string");
  });
  test("La carrera viene como objeto (relacion)", function () {
    expect(res.getBody().carrera.nombre).to.be.a("string");
  });
}

docs {
  Crea un alumno. Guarda su id en {{alumnoId}}.
  Si el numero de control ya existe responde 409.
}
