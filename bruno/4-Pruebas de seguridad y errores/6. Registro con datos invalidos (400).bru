meta {
  name: 6. Registro con datos invalidos (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "",
    "email": "correo-invalido",
    "password": "123"
  }
}

tests {
  test("Responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
