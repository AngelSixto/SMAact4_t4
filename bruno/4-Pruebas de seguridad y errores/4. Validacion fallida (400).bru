meta {
  name: 4. Validacion fallida (400)
  type: http
  seq: 4
}

post {
  url: http://157.180.30.55:8088/api/alumnos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "numeroControl": "123",
    "nombre": "",
    "apellidos": "Prueba",
    "email": "esto-no-es-un-email",
    "semestre": 20,
    "carreraId": null
  }
}

tests {
  test("Responde 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("Indica el error de cada campo", function () {
    expect(res.getBody().errores).to.have.property("email");
  });
}

docs {
  Envia datos invalidos a proposito para comprobar @Valid.
